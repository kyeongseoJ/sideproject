# Spring Boot / Supabase PostgreSQL
DB_URL=jdbc:postgresql://your-project.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=your_supabase_database_user
DB_PASSWORD=your_supabase_database_password

# Comma-separated Web origins allowed to call /api/**. Set the deployed Flutter Web URL in Coolify.
CORS_ALLOWED_ORIGIN_PATTERNS=https://app.example.com

# Optional: LLM mission generation
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
